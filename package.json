{
	"name": "ProfileDock",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:desktop": "turbo run dev -F @profiledock/desktop --",
		"desktop:dev": "pnpm --filter @profiledock/desktop desktop:dev",
		"desktop:build": "pnpm --filter @profiledock/desktop desktop:build",
		"cloak:install": "pnpm --filter @profiledock/desktop cloak:install",
		"cloak:info": "pnpm --filter @profiledock/desktop cloak:info",
		"cloak:update": "pnpm --filter @profiledock/desktop cloak:update",
		"cloak:setup": "node scripts/setup-cloak.mjs",
		"cloak:setup:linux": "bash scripts/setup-cloak.sh",
		"cloak:setup:windows": "powershell -ExecutionPolicy Bypass -File scripts/setup-cloak.ps1",
		"check": "biome check --write .",
		"changeset": "changeset",
		"changeset:version": "changeset version",
		"changeset:release": "node scripts/create-release-tag.mjs",
		"version": "node scripts/sync-app-version.mjs"
	},
	"dependencies": {
		"@ProfileDock/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@ProfileDock/config": "workspace:*",
		"@biomejs/biome": "^2.5.11",
		"@changesets/cli": "^3.0.1",
		"@types/node": "catalog:",
		"turbo": "^2.10.12",
		"typescript": "catalog:"
	},
	"packageManager": "pnpm@11.5.1"
}
